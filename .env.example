# ==============================================================================
# PromoCuts - Variáveis de Ambiente
# Copie este arquivo para .env.local no desenvolvimento local
# Na Vercel, preencha estas variáveis nas configurações de Environment Variables
# ==============================================================================

# Supabase (Acesse no Dashboard do Supabase: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave de Serviço do Supabase (Apenas Servidor - NUNCA exponha no cliente com NEXT_PUBLIC_)
# Utilizada em Server Actions para gravação protegida de vídeos e produtos
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# E-mail do Administrador (Proprietário da Instância)
# Apenas este e-mail terá permissão para logar em /admin e gerenciar o catálogo
ADMIN_EMAIL=seu-email@dominio.com

# URL Base da Aplicação (necessária para redirects do Supabase Auth)
# Local: http://localhost:3000
# Produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
