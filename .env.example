# ==============================================================================
# PromoCuts — Variáveis de Ambiente: Vercel + Supabase Cloud (Plano Gratuito)
# ==============================================================================
# Para desenvolvimento local com Supabase, copie este arquivo:
# cp .env.example .env.local
#
# Na Vercel, cadastre as variáveis abaixo no painel do projeto.
# NUNCA comite arquivos .env ou .env.local no controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais Obrigatórias
# ------------------------------------------------------------------------------
# E-mail exclusivo do Administrador (Proprietário da Instância)
# Apenas este e-mail tem autorização para acessar o painel /admin e modificar dados
ADMIN_EMAIL=seu-email@dominio.com

# URL Base da Aplicação
# Local: http://localhost:3000
# Produção: https://seu-app.vercel.app ou https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta de sessão para criptografia de cookies e tokens de autenticação
# OBRIGATÓRIO: Gere uma chave segura com: openssl rand -base64 32
AUTH_SECRET=gere-uma-chave-secreta-longa-e-aleatoria-com-openssl

# Modo de Desenvolvimento e Diagnóstico (true ou false)
# Ativa logs verbosos no servidor para facilitar depuração de consultas e embeds
IS_DEV=false

# ------------------------------------------------------------------------------
# 2. Conexão com Supabase Cloud (PostgreSQL + Auth + Storage)
# Obtenha em: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ALERTA DE SEGURANÇA: A chave Service Role possui bypass total de RLS (Row Level Security).
# NUNCA a exponha com o prefixo NEXT_PUBLIC_ e NUNCA a compartilhe publicamente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Conexão direta PostgreSQL para automação de migrações no deploy (Opcional — Altamente Recomendado)
# Se preenchida na Vercel, o deploy aplica automaticamente todas as migrações de supabase/migrations/
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Modo Transaction/Session)
# Exemplo: postgresql://postgres.[project-ref]:[sua-senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Cache e Rate Limiting via Upstash Redis (Opcional)
# ------------------------------------------------------------------------------
# Se desejar habilitar rate limiting em borda serverless via HTTP/REST:
# UPSTASH_REDIS_REST_URL=https://seu-upstash.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token-aqui

# ------------------------------------------------------------------------------
# 4. Segurança do Painel /admin: Restrição de Acesso por VPN / IP (Opcional)
# ------------------------------------------------------------------------------
# Lista de IPs ou blocos CIDR autorizados (ex: Tailscale, WireGuard ou rede interna)
# Se preenchido, qualquer requisição para /admin fora dessas faixas recebe 403 Forbidden
# ADMIN_ALLOWED_IPS=100.64.0.0/10,10.0.0.0/8,127.0.0.1

# ------------------------------------------------------------------------------
# 5. CI/CD e Automação de Migrações via Supabase CLI (Opcional)
# Utilizado pelo GitHub Actions (.github/workflows/migrations.yml) ou CLI local.
# No GitHub: Cadastre essas variáveis em Settings > Secrets and variables > Actions.
# ------------------------------------------------------------------------------
# ID de Referência do Projeto Supabase (obtido na URL ou em Project Settings > General)
# Permite ao Supabase CLI saber exatamente em qual banco aplicar as migrações
# SUPABASE_PROJECT_ID=seu-project-ref-aqui

# Senha do banco PostgreSQL definida na criação do projeto no Supabase
# Permite autenticar a conexão direta de DDL para criação e alteração de tabelas
# SUPABASE_DB_PASSWORD=sua-senha-do-banco-aqui

# Personal Access Token gerado em: https://supabase.com/dashboard/account/tokens
# Permite ao GitHub Actions gerenciar o projeto Supabase de forma segura e sem interação humana
# SUPABASE_ACCESS_TOKEN=seu-personal-access-token-aqui

# ------------------------------------------------------------------------------
# 6. Monitoramento de Ofertas: Segredo do Vercel Cron Job (Opcional)
# ------------------------------------------------------------------------------
# Chave secreta de autorização para a rota /api/cron/check-offers disparada pela Vercel.
# Gere uma chave segura ou defina no painel da Vercel em Project Settings > Environment Variables.
# CRON_SECRET=gere-um-segredo-de-cron-longo-e-aleatorio


