# ==============================================================================
# PromoCuts - Variaveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env.local no desenvolvimento local
# Na Vercel ou no Docker, configure as variaveis do modo desejado
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuracoes Globais Obrigatorias
# ------------------------------------------------------------------------------
# E-mail exclusivo do Administrador (Proprietario da Instancia)
# Apenas este e-mail tem autorizacao para acessar o painel /admin e mutar dados
ADMIN_EMAIL=seu-email@dominio.com

# URL Base da Aplicacao
# Local: http://localhost:3000
# Producao: https://seu-dominio.com ou https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta de sessao para criptografia de cookies e tokens de autenticacao
# Gere com: openssl rand -base64 32
AUTH_SECRET=sua-chave-secreta-longa-e-aleatoria-aqui

# ------------------------------------------------------------------------------
# 2. Modo A: Nuvem Serverless (Vercel + Supabase)
# Preencha se estiver rodando no plano gratuito da Vercel com Supabase Cloud
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ------------------------------------------------------------------------------
# 3. Modo B: Self-Hosted / Docker (PostgreSQL 18.6 Direto)
# Preencha se estiver executando via Docker Compose ou VPS propria
# ------------------------------------------------------------------------------
# String de conexao direta com o banco relacional
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promocuts
POSTGRES_DB=promocuts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 4. Cache e Rate Limiting via Redis (Opcional)
# O sistema funciona perfeitamente sem Redis se estas variaveis ficarem vazias
# ------------------------------------------------------------------------------
# No Docker ou VPS (conexao TCP tradicional):
REDIS_URL=redis://localhost:6379

# Na Vercel / Serverless (Upstash Redis via HTTP/REST - 100% gratuito):
# UPSTASH_REDIS_REST_URL=https://seu-upstash.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token-aqui

# ------------------------------------------------------------------------------
# 5. Seguranca do Painel /admin: Restricao de Acesso por VPN (Opcional)
# Permite isolar o /admin para que seja acessivel exclusivamente via VPN
# ------------------------------------------------------------------------------
# Lista de IPs ou blocos CIDR autorizados (ex: faixas do Tailscale, WireGuard ou rede interna)
# Se preenchido, qualquer requisicao para /admin fora dessas faixas recebe 403 Forbidden
# Exemplos:
# - Tailscale: 100.64.0.0/10
# - WireGuard / Rede Local: 10.0.0.0/8, 192.168.1.0/24
# - IP Estatico: 203.0.113.45
ADMIN_ALLOWED_IPS=100.64.0.0/10,10.0.0.0/8,127.0.0.1

# ------------------------------------------------------------------------------
# 6. Seguranca do Painel /admin: Single Sign-On - SSO (Opcional)
# Permite autenticar via provedor corporativo validando estritamente contra ADMIN_EMAIL
# Provedores suportados: google, github, oidc
# ------------------------------------------------------------------------------
SSO_PROVIDER=google
SSO_CLIENT_ID=seu-client-id-aqui
SSO_CLIENT_SECRET=seu-client-secret-aqui

# Para OIDC generico (Authentik, Keycloak, Authelia, Cloudflare Access):
# SSO_ISSUER_URL=https://auth.seu-dominio.com/application/o/promocuts/
