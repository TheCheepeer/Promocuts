# ==============================================================================
# PromoCuts - Variaveis de Ambiente: Docker Compose (Self-Hosted / VPS)
# ==============================================================================
# Para rodar com Docker Compose, copie este arquivo:
# cp .env.example.docker .env
#
# NUNCA comite o arquivo .env preenchido no controle de versao.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuracoes Gerais Obrigatorias
# ------------------------------------------------------------------------------
# E-mail exclusivo do Administrador (Proprietario da Instancia)
# Apenas este e-mail tem autorizacao para acessar o painel /admin e mutar dados
ADMIN_EMAIL=seu-email@dominio.com

# URL Base da Aplicacao
# Local: http://localhost:80 ou http://localhost:3000
# Producao: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:80

# Chave secreta de sessao para criptografia de cookies e tokens de autenticacao
# OBRIGATORIO: Gere uma chave segura com: openssl rand -base64 32
AUTH_SECRET=gere-uma-chave-secreta-longa-e-aleatoria-com-openssl

# Modo de Desenvolvimento e Diagnostico (true ou false)
# Ativa logs verbosos no servidor para facilitar depuracao de consultas e embeds
IS_DEV=false

# Porta publica HTTP exposta pelo gateway Nginx
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional (PostgreSQL 18.6 Interno)
# ------------------------------------------------------------------------------
POSTGRES_DB=promocuts
POSTGRES_USER=promocuts_user
# OBRIGATORIO: Defina uma senha forte. NUNCA utilize senhas padrao em producao.
POSTGRES_PASSWORD=defina-uma-senha-forte-para-o-postgres
DATABASE_URL=postgresql://promocuts_user:defina-uma-senha-forte-para-o-postgres@db:5432/promocuts

# ------------------------------------------------------------------------------
# 3. Cache e Rate Limiting via Redis 8 Interno (Opcional)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=defina-uma-senha-forte-para-o-redis
REDIS_URL=redis://:defina-uma-senha-forte-para-o-redis@redis:6379

# ------------------------------------------------------------------------------
# 4. Seguranca do Painel /admin: Restricao de Acesso por VPN (Opcional)
# ------------------------------------------------------------------------------
# Lista de IPs ou blocos CIDR autorizados (ex: Tailscale, WireGuard ou rede interna)
# Se preenchido, qualquer requisicao para /admin fora dessas faixas recebe 403 Forbidden
# ADMIN_ALLOWED_IPS=100.64.0.0/10,10.0.0.0/8,127.0.0.1

# ------------------------------------------------------------------------------
# 5. Seguranca do Painel /admin: Single Sign-On - SSO (Opcional)
# Permite autenticar via provedor corporativo validando estritamente contra ADMIN_EMAIL
# Provedores suportados: google, github, oidc
# ------------------------------------------------------------------------------
# SSO_PROVIDER=google
# SSO_CLIENT_ID=seu-client-id-aqui
# SSO_CLIENT_SECRET=seu-client-secret-aqui

# Para OIDC generico (Authentik, Keycloak, Authelia, Cloudflare Access):
# SSO_ISSUER_URL=https://auth.seu-dominio.com/application/o/promocuts/
