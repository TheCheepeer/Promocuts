# ==============================================================================
# PromoCuts - Variaveis de Ambiente: Vercel + Supabase Cloud (Plano Gratuito)
# ==============================================================================
# Para desenvolvimento local com Supabase, copie este arquivo:
# cp .env.example.vercel .env.local
#
# Na Vercel, cadastre as variaveis abaixo no painel do projeto.
# NUNCA comite arquivos .env ou .env.local no controle de versao.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuracoes Gerais Obrigatorias
# ------------------------------------------------------------------------------
# E-mail exclusivo do Administrador (Proprietario da Instancia)
# Apenas este e-mail tem autorizacao para acessar o painel /admin e mutar dados
ADMIN_EMAIL=seu-email@dominio.com

# URL Base da Aplicacao
# Local: http://localhost:3000
# Producao: https://seu-app.vercel.app ou https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta de sessao para criptografia de cookies e tokens de autenticacao
# OBRIGATORIO: Gere uma chave segura com: openssl rand -base64 32
AUTH_SECRET=gere-uma-chave-secreta-longa-e-aleatoria-com-openssl

# Modo de Desenvolvimento e Diagnostico (true ou false)
# Ativa logs verbosos no servidor para facilitar depuracao de consultas e embeds
IS_DEV=false

# ------------------------------------------------------------------------------
# 2. Conexao com Supabase Cloud (PostgreSQL + Auth + Storage)
# Obtenha em: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ALERTA DE SEGURANCA: A chave Service Role possui bypass total de RLS (Row Level Security).
# NUNCA a exponha com o prefixo NEXT_PUBLIC_ e NUNCA a compartilhe publicamente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ------------------------------------------------------------------------------
# 3. Cache e Rate Limiting via Upstash Redis (Opcional)
# ------------------------------------------------------------------------------
# Se desejar habilitar rate limiting em borda serverless via HTTP/REST:
# UPSTASH_REDIS_REST_URL=https://seu-upstash.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu-token-aqui

# ------------------------------------------------------------------------------
# 4. Seguranca do Painel /admin: Restricao de Acesso por VPN / IP (Opcional)
# ------------------------------------------------------------------------------
# Lista de IPs ou blocos CIDR autorizados (ex: Tailscale, WireGuard ou rede interna)
# Se preenchido, qualquer requisicao para /admin fora dessas faixas recebe 403 Forbidden
# ADMIN_ALLOWED_IPS=100.64.0.0/10,10.0.0.0/8,127.0.0.1

# ------------------------------------------------------------------------------
# 5. CI/CD e Automacao de Migracoes via Supabase CLI (Opcional)
# Utilizado pelo GitHub Actions (.github/workflows/migrations.yml) ou CLI local.
# No GitHub: Cadastre essas variaveis em Settings > Secrets and variables > Actions.
# ------------------------------------------------------------------------------
# ID de Referencia do Projeto Supabase (obtido na URL ou em Project Settings > General)
# Permite ao Supabase CLI saber exatamente em qual banco aplicar as migracoes
# SUPABASE_PROJECT_ID=seu-project-ref-aqui

# Senha do banco PostgreSQL definida na criacao do projeto no Supabase
# Permite autenticar a conexao direta de DDL para criacao e alteracao de tabelas
# SUPABASE_DB_PASSWORD=sua-senha-do-banco-aqui

# Personal Access Token gerado em: https://supabase.com/dashboard/account/tokens
# Permite ao GitHub Actions gerenciar o projeto Supabase de forma segura e sem interacao humana
# SUPABASE_ACCESS_TOKEN=seu-personal-access-token-aqui
